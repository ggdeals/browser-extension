{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "0.0.0",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "homepage_url": "https://github.com/ggdeals/browser-extension",
  "icons": {
    "16": "src/assets/gg-ext-icon-16.png",
    "48": "src/assets/gg-ext-icon-48.png",
    "128": "src/assets/gg-ext-icon-128.png"
  },
  "action": {
    "default_popup": "index.html",
    "default_title": "GG.deals sync extension",
    "default_icon": {
      "16": "src/assets/gg-ext-icon-16.png",
      "48": "src/assets/gg-ext-icon-48.png",
      "128": "src/assets/gg-ext-icon-128.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*/*"
  ],
  "background": {
    "scripts": [
      "src/background.ts"
    ],
    "type": "module"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "extension@gg.deals",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' http://localhost:5173; object-src 'self'"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.gg.deals/*"
      ],
      "js": [
        "src/csrf-page-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.gg.deals/*"
      ],
      "js": [
        "src/extension-installed-marker.js",
        "src/content-settings.ts"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://ec.nintendo.com/*",
        "https://accounts.nintendo.com/*"
      ],
      "js": [
        "src/integrations/nintendo/nintendo-account-nickname.ts",
        "src/integrations/nintendo/nintendo-wishlist-query-hash.ts"
      ],
      "run_at": "document_idle"
    },
    {
